# Copia este archivo a ".env" (sin el .example) y completá los valores.
# El archivo ".env" real NUNCA se sube a git (está en .gitignore) — es solo para tu compu.

# Contraseña para /library.html (listar/borrar videos ya subidos). Si la dejás sin definir,
# el servidor genera una al azar en cada arranque y la muestra por consola.
LIBRARY_PASSWORD=elige-una-contraseña-para-tu-grupo

# Puerto en el que corre el servidor. Por defecto 3000.
# PORT=3000
