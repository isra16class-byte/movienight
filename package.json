{
  "name": "movienight",
  "version": "1.0.0",
  "description": "Watch party privado para ver pelis con amigos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tunnel": "cloudflared tunnel --config cloudflared-config.yml run",
    "r2:cleanup": "node scripts/r2-cleanup-multipart.js",
    "library:orphans": "node scripts/library-orphan-report.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop movienight",
    "pm2:restart": "pm2 restart movienight",
    "pm2:logs": "pm2 logs movienight",
    "pm2:status": "pm2 status movienight"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "ioredis": "^6.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "socket.io": "^4.7.5"
  }
}
